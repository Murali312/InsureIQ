# ==============================================================================
# India Health Insurance AI Agent - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your keys. Never commit .env to source control.

# OpenAI chat / answer generation
OPENAI_API_KEY=sk-proj-your-chat-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Embedding provider (options: "openai" or "local")
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_API_KEY=sk-proj-your-embedding-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local embedding settings (used when EMBEDDING_PROVIDER=local or as offline fallback)
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Application settings
CHROMA_PERSIST_DIRECTORY=./vector_store/chroma
COLLECTION_NAME=india_health_insurance_kb
APP_ENV=development
LOG_LEVEL=INFO

# Controlled Live Web Lookup Settings
ALLOW_WEB_LOOKUP=true
REQUEST_TIMEOUT_SECONDS=10
MAX_WEB_FETCH_BYTES=1048576

# Optional AWS Bedrock Integration (Not required for local operation)
AWS_REGION=us-east-1
AWS_BEDROCK_KB_ID=
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
