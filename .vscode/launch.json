{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Streamlit: Run Health Insurance App",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py",
                "--server.port=8501"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Script: Ingest Knowledge Base",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/ingest.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Script: Ingest Knowledge Base (--reset)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/ingest.py",
            "args": [
                "--reset"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Script: Validate Sources",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/validate_sources.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Pytest: Run Test Suite",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests",
                "-v"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
